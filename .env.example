# Copie para .env e preencha. Nunca versione o .env.

# DIRECT_URL opcional: conexão direta/sessão usada só pelas migrations (ex.: Supabase porta 5432)
DIRECT_URL=""

# PostgreSQL (local: `npx prisma dev` mostra a URL; produção: Neon/Supabase/Prisma Postgres)
DATABASE_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"
# Conexões simultâneas do pool. Use 1 com o `prisma dev` local; 5-10 em produção.
DATABASE_POOL_MAX="5"

# Segredo das sessões (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# URL pública do site (usada no Mercado Pago, sitemap e links de rastreio)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mercado Pago (Checkout Pro). Sem estas variáveis, Pix/cartão ficam desativados
# e a loja aceita apenas pagamento na entrega/retirada.
# Painel do desenvolvedor: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
# Segredo da assinatura do webhook (Suas integrações > Webhooks > Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=""

# Administrador criado pelo seed (`npm run db:seed`). Use uma senha forte.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
